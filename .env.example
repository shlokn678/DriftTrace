# DriftTrace - non-secret local defaults (no real credentials; NFR-7).
# Copy to .env for local overrides. Container-to-container uses Docker service DNS
# names (mlflow, redpanda, webhook-stub), NOT localhost.

# --- Ports exposed to the host ---
DRIFTTRACE_API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080
REDPANDA_PORT=9092
WEBHOOK_STUB_PORT=9000

# --- Serving / model ---
# Inside Compose the API talks to the mlflow service by DNS name.
MLFLOW_TRACKING_URI=http://mlflow:5000
# Optional: pin a specific registered model version (default: latest).
# DRIFTTRACE_MODEL_VERSION=1
DRIFTTRACE_TRANSFORM_PARAMS=/app/artifacts/transform_params.json

# --- Event emission / streaming ---
# core profile: false -> API writes prediction events to a local JSON-lines file.
# full profile: true  -> API emits prediction events to Redpanda.
DRIFTTRACE_USE_REDPANDA=false
REDPANDA_BROKER=redpanda:9092
DRIFTTRACE_TOPIC=drifttrace.predictions
DRIFTTRACE_EVENT_LOG=/app/reports/events.jsonl

# --- Webhook stub ---
WEBHOOK_STUB_URL=http://webhook-stub:9000/alert

# --- Stretch (unused in MVP; Prometheus/Grafana are Phase 4/stretch) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
