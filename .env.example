# DriftTrace - optional local overrides (no real credentials; NFR-7).
# Copy to .env only if you need to change a default. Everything works with NO .env:
# paths resolve relative to the repository, MLflow uses a local SQLite database, and
# prediction events are written to a local file. No Docker, no broker required.

# --- Paths (optional; default to <repo>/data, <repo>/artifacts, <repo>/reports) ---
# DRIFTTRACE_ROOT=
# DRIFTTRACE_DATA_DIR=
# DRIFTTRACE_ARTIFACTS_DIR=
# DRIFTTRACE_REPORTS_DIR=
# DRIFTTRACE_MODEL_STORE=

# --- Serving / model ---
# MLflow backend (default: sqlite:///<repo>/mlflow.db). Local file, no server needed.
# MLFLOW_TRACKING_URI=
# Pin a specific registered model version (default: latest).
# DRIFTTRACE_MODEL_VERSION=1
# Where the API writes prediction events (default: <repo>/reports/events.jsonl).
# DRIFTTRACE_EVENT_LOG=
# Allowed dashboard origins for CORS (default: localhost:5173 / 4173 / 127.0.0.1:5173).
# DRIFTTRACE_CORS_ORIGINS=

# --- Optional external webhook for alerts (default: none; alerts are logged locally) ---
# WEBHOOK_STUB_URL=http://localhost:9000/alert

# --- Optional: emit events to a separately-run Redpanda/Kafka broker (NOT required) ---
# The normal local/demo workflow does NOT use a broker. Only set these if you run one.
# DRIFTTRACE_USE_REDPANDA=false
# REDPANDA_BROKER=localhost:9092
# DRIFTTRACE_TOPIC=drifttrace.predictions
